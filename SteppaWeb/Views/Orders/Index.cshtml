@model List<Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New order</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td>@order.Customer?.Name</td>
                <td>@order.Product?.Name</td>
                <td>@order.Quantity</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">No orders yet.</td>
            </tr>
        }
    </tbody>
</table>