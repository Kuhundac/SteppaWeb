@model List<Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add customer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.Phone</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="2" class="text-muted">No customers yet.</td>
            </tr>
        }
    </tbody>
</table>