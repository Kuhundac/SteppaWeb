@model List<SteppaWeb.Models.Product>

@{
    var sort = ViewData["Sort"] as string;
    var search = ViewData["Search"] as string;
    var lowStock = ViewData["LowStock"] as bool? ?? false;
    string? lowParam = lowStock ? "true" : null;

    // What a header click should ask for next
    string NextSort(string field)
    {
        if (field == "name")
            return sort == "name_desc" ? "name" : "name_desc";
        return sort == field ? field + "_desc" : field;
    }

    // Small arrow showing the current sort
    string Arrow(string field)
    {
        if (sort == field || (field == "name" && string.IsNullOrEmpty(sort))) return " ▲";
        if (sort == field + "_desc") return " ▼";
        return "";
    }
}

<h1>STEPPA Products</h1>

<form asp-action="Products" method="get" class="mb-3">
    <input type="hidden" name="sort" value="@sort" />
    <div class="input-group mb-2">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name or color" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Products" class="btn btn-outline-secondary">Clear</a>
    </div>
    <div class="form-check">
        <input type="checkbox" id="lowStock" name="lowStock" value="true" class="form-check-input" checked="@lowStock" />
        <label for="lowStock" class="form-check-label">Low stock only (20 or fewer)</label>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th><a asp-action="Products" asp-route-search="@search" asp-route-lowStock="@lowParam" asp-route-sort="@NextSort("name")" class="text-dark text-decoration-none">@("Name" + Arrow("name"))</a></th>
            <th>Color</th>
            <th><a asp-action="Products" asp-route-search="@search" asp-route-lowStock="@lowParam" asp-route-sort="@NextSort("price")" class="text-dark text-decoration-none">@("Price" + Arrow("price"))</a></th>
            <th><a asp-action="Products" asp-route-search="@search" asp-route-lowStock="@lowParam" asp-route-sort="@NextSort("stock")" class="text-dark text-decoration-none">@("Stock" + Arrow("stock"))</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Color</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">No products found.</td>
            </tr>
        }
    </tbody>
</table>